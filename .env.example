# Kopieer naar .env.local en vul minstens één sleutel in.

# Volgorde waarin aanbieders geprobeerd worden (bij een limiet- of serverfout gaat hij naar de volgende).
COACH_PROVIDERS=groq,gemini

# Groq (gratis tier) – sleutel aanmaken: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (gratis tier) – sleutel aanmaken: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter (gratis :free-modellen) – https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Ollama (lokaal) – alleen actief als OLLAMA_MODEL gezet is
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optioneel wachtwoord voor /api/coach als de site online staat (vul hetzelfde in bij Instellingen).
# COACH_ACCESS_TOKEN=
